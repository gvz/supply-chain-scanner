          <mxGeometry x="1210" y="290" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="u4" value="OSV feeds&#10;(one zip per ecosystem)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1210" y="380" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="u5" value="AI provider&#10;(OpenAI-compatible)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1210" y="450" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="u6" value="cargo-vet audit sources&#10;(trusted reviewer proof)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1210" y="520" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="u7" value="The audit endpoints are answered locally&#10;and never proxied: shipping the org's&#10;dependency tree upstream is a data-egress&#10;change nobody asked for." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;spacingLeft=2;" vertex="1" parent="1">
          <mxGeometry x="1210" y="600" width="300" height="90" as="geometry" />
        </mxCell>

