<mxfile host="app.diagrams.net" agent="supply-chain-scanner" version="24.0.0">
  <diagram id="overview" name="1. System Overview">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Supply Chain Scanner — System Overview" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="One binary, three deployments (PyPI, cargo, npm). One process serves exactly one ecosystem." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="900" height="24" as="geometry" />
        </mxCell>

        <mxCell id="devlane" value="DEVELOPER MACHINES" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#d6d6d6;verticalAlign=top;align=left;fontStyle=1;fontSize=12;fontColor=#666666;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="380" height="300" as="geometry" />
        </mxCell>

        <mxCell id="pip" value="pip&#10;index-url = public_url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cargo" value="cargo&#10;source replacement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="235" y="140" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="npm" value="npm&#10;npm config set registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="220" width="315" height="60" as="geometry" />
        </mxCell>
        <mxCell id="devinfo" value="No wrapper or plugin is installed on a developer machine.&#10;Only the registry URL changes, so the tool believes it talks to the&#10;public registry." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;spacingLeft=2;" vertex="1" parent="1">
          <mxGeometry x="70" y="300" width="330" height="80" as="geometry" />
        </mxCell>

        <mxCell id="proxy" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;fontStyle=1;fontSize=13;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="100" width="640" height="620" as="geometry" />
        </mxCell>
        <mxCell id="proxylabel" value="SCANNER PROXY (one process, one ecosystem)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="486" y="112" width="500" height="28" as="geometry" />
        </mxCell>

        <mxCell id="httplayer" value="HTTP layer (src/http)&#10;routes + refusal rendering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="160" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="scanlayer" value="Scan layer (src/scan)&#10;cascade + full scan + dedup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="800" y="160" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="gates" value="THE FIVE GATES, IN ORDER (PyPI full scan)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="500" y="255" width="360" height="24" as="geometry" />
        </mxCell>

        <mxCell id="g1" value="1. Release age&#10;(best effort)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="285" width="112" height="62" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="2. CVE line&#10;(OSV mirror)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="622" y="285" width="112" height="62" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="3. Digest verify&#10;(before unpack)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="744" y="285" width="112" height="62" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="4. Org plugins&#10;(after unpack)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="866" y="285" width="112" height="62" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="5. AI review&#10;(optional, last)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="988" y="285" width="112" height="62" as="geometry" />
        </mxCell>
        <mxCell id="gateend" value="Every gate is fail-closed: a check that cannot run is Unverifiable, never a serve.&#10;This order is the PyPI path, where one full scan runs all five.&#10;cargo and npm split it: CVE, release age and AI review at the metadata gate (sparse index /&#10;packument), then the plugins at the download, which also requires that earlier admission." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#b85450;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="500" y="360" width="600" height="60" as="geometry" />
        </mxCell>

        <mxCell id="stores" value="DURABLE STATE (SQLite)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="500" y="440" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="verdicts&#10;one row per artifact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="470" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="advisories&#10;OSV mirror" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="645" y="470" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="artifact_cache&#10;verified bytes on disk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="790" y="470" width="140" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="reviews&#10;AI audit trail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="945" y="470" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="index_cache / cargo_vet&#10;metadata + audit proofs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="540" width="275" height="55" as="geometry" />
