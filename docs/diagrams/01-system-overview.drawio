        <mxCell id="o4" value="/api/reviews" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="836" y="648" width="100" height="40" as="geometry" />
