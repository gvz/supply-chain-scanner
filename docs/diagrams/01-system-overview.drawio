        <mxCell id="upstream" value="EXTERNAL WORLD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#d6d6d6;verticalAlign=top;align=left;fontStyle=1;fontSize=12;fontColor=#666666;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1180" y="100" width="360" height="620" as="geometry" />
        </mxCell>
        <mxCell id="u1" value="PyPI&#10;(simple index + files)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1210" y="150" width="300" height="55" as="geometry" />
