        <mxCell id="ann_coord" value="ONE PRIMITIVE, TWO USERS&#10;scan/coordinator.rs is a single-flight dedup primitive that is used&#10;twice: once to dedup concurrent AI reviews of the same artifact, and&#10;once to dedup concurrent plugin runs." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;fontSize=10;fontColor=#1a1a1a;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1470" y="300" width="430" height="92" as="geometry" />
        </mxCell>
        <mxCell id="ann_trait" value="KNOWN DEFECT&#10;ecosystem/traits.rs declares an Ecosystem trait, but only pypi&#10;implements it. cargo and npm hold concrete upstream clients instead,&#10;so the abstraction is declared and barely exercised. This is a known&#10;defect listed in docs/operations.md." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;fontSize=10;fontColor=#1a1a1a;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1470" y="420" width="430" height="108" as="geometry" />
        </mxCell>
        <mxCell id="ann_versions" value="WHY policy → ai EXISTS&#10;policy/mod.rs imports crate::ai::collect and crate::ai::prompt to fold&#10;COLLECTOR_VERSION and PROMPT_VERSION into the policy fingerprint. That&#10;is the whole edge: versions only. policy does not run reviews and&#10;does not depend on AI behaviour." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;fontSize=10;fontColor=#1a1a1a;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1470" y="556" width="430" height="108" as="geometry" />
        </mxCell>
