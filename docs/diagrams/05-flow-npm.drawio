<mxfile host="app.diagrams.net" agent="supply-chain-scanner" version="24.0.0">
  <diagram id="flow-npm" name="5. npm Two-Gate Flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="npm Two-Gate Flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="npm has no cargo-vet-shaped fast path. A version reaches a forwarded packument only if it is CVE-clean, past the release-age threshold (or allowlisted), and AI-review-passed. There is no substitute for the review step." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="1480" height="24" as="geometry" />
        </mxCell>

        <mxCell id="ph1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1200" height="350" as="geometry" />
        </mxCell>
        <mxCell id="ph1_t" value="PHASE 1 — the packument. `GET /&lt;name&gt;`, or `/@scope%2fname` for a scoped package." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#9c5a00;" vertex="1" parent="1">
          <mxGeometry x="54" y="110" width="900" height="26" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="npm resolves&#10;(install / view)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="npm_packument_handler&#10;validate_name FIRST (400 before upstream)&#10;then NpmScanner::decide_packument" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="270" y="140" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="fetch the FULL packument&#10;never the abbreviated form:&#10;the age gate needs the `time` map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="140" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="over-size or unparseable&#10;→ error, never a partial document" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="900" y="140" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n4n" value="A truncated parse would drop versions&#10;indistinguishably from the gate removing&#10;them, so it fails closed." style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#9c2b25;" vertex="1" parent="1">
          <mxGeometry x="900" y="215" width="300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="casc" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="270" y="240" width="930" height="120" as="geometry" />
        </mxCell>
        <mxCell id="casc_t" value="the newest-per-major cascade — eager filtering of the whole version list on every request" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="280" y="246" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cg1" value="CVE filter&#10;(OSV npm feed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=center;" vertex="1" parent="1">
          <mxGeometry x="284" y="274" width="130" height="72" as="geometry" />
        </mxCell>
        <mxCell id="cg2" value="release age&#10;from the time map&#10;(best effort)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=center;" vertex="1" parent="1">
          <mxGeometry x="424" y="274" width="130" height="72" as="geometry" />
        </mxCell>
        <mxCell id="cg3" value="allowlist&#10;override" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=center;" vertex="1" parent="1">
          <mxGeometry x="564" y="274" width="110" height="72" as="geometry" />
        </mxCell>
        <mxCell id="cg4" value="AI review&#10;NO fast path, ever" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="684" y="274" width="150" height="72" as="geometry" />
        </mxCell>
        <mxCell id="cg5" value="group by caret semantics:&#10;major &gt; 0 → major&#10;0.x → minor&#10;0.0.x → patch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=center;" vertex="1" parent="1">
          <mxGeometry x="844" y="274" width="170" height="72" as="geometry" />
        </mxCell>
        <mxCell id="cg6" value="newest passing&#10;version per line,&#10;newest line first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;" vertex="1" parent="1">
          <mxGeometry x="1024" y="274" width="150" height="72" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="filter_packument: prune versions to the survivors; rewrite every dist.tarball to {public_url}/{name}/-/{unscoped}-{version}.tgz; rebuild dist-tags so latest names a version that is actually present, or dist-tags is empty. Non-latest tags whose target vanished are dropped, not repointed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="270" y="375" width="930" height="55" as="geometry" />
        </mxCell>

        <mxCell id="dep" value="DEPRECATED VERSIONS ARE STILL CANDIDATES&#10;npm installs deprecated versions routinely. Excluding them would break ordinary&#10;resolution for no security gain, so nothing in this cascade filters on deprecation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;fontSize=10;fontColor=#7f6000;spacingLeft=10;spacingTop=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="245" width="190" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ph2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="1200" height="330" as="geometry" />
        </mxCell>
        <mxCell id="ph2_t" value="PHASE 2 — the tarball. `GET /&lt;name&gt;/-/&lt;file&gt;`" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#9c2b25;" vertex="1" parent="1">
          <mxGeometry x="54" y="490" width="700" height="26" as="geometry" />
        </mxCell>

        <mxCell id="routed" value="ROUTE DISPATCH, NOT A ROUTE OF ITS OWN&#10;The plan called for `/{*name}/-/{file}`. matchit, which axum 0.8 uses, rejects a catch-all&#10;that is not the final path segment: 'Catch-all parameters are only allowed at the end of a route'.&#10;The narrower `/{name}/-/{file}` conflicts with the existing `/{*path}`. So the tarball is&#10;dispatched from the one catch-all: `looks_like_tarball(path)` recognizes it and hands off&#10;before the path is treated as a package name. Externally identical, scoped names included." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;fontColor=#1f4e79;spacingLeft=10;spacingTop=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="525" width="380" height="140" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="npm tarball request&#10;(scoped: literal unencoded /)&#10;filename must be exactly&#10;{unscoped}-{version}.tgz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="470" y="525" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="METADATA APPROVAL FIRST&#10;NpmScanner::approved_for_download" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="525" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="NOT approved → 403 refusal&#10;ZERO fetches, ZERO plugin runs,&#10;never reviewed inline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="605" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d4" value="download tarball, verify digest&#10;(integrity sha512 → shasum sha1 fallback)&#10;before ANY unpack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="470" y="690" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="unpack → org plugins&#10;deduped by digest, one run&#10;per artifact under concurrency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="740" y="690" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="store Clean, mark plugin_checked,&#10;cache, serve bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="690" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d3n" value="THE CONSTRAINT&#10;No tarball bytes are served for an artifact that has not&#10;passed CVE, release age, AI review AND the plugins. Serving&#10;an unapproved version on a plugin pass would substitute&#10;one check for the other three." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;fontSize=10;fontColor=#9c2b25;spacingLeft=10;spacingTop=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="690" width="380" height="110" as="geometry" />
        </mxCell>

        <mxCell id="decisions" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="1200" height="230" as="geometry" />
        </mxCell>
        <mxCell id="decisions_t" value="npm-specific decisions that are easy to get wrong" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#7f6000;" vertex="1" parent="1">
          <mxGeometry x="54" y="858" width="700" height="26" as="geometry" />
        </mxCell>
        <mxCell id="dec1" value="WRITE AND AUTH ARE REFUSED&#10;PUT, POST, PATCH and DELETE on any path answer 403 with a&#10;sentence: this is a read-only gateway, so publish, login, token&#10;and dist-tag are unsupported. Explicit rather than the router's&#10;bare method-not-allowed answer, so an operator learns why&#10;immediately instead of from a half-completed publish.&#10;The two audit stubs keep their own POST routes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=10;fontColor=#9c2b25;spacingLeft=10;spacingTop=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="890" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dec2" value="THE AUDIT ENDPOINTS ANSWER 404, LOCALLY&#10;/-/npm/v1/security/advisories/bulk and /audits/quick are never&#10;proxied. Forwarding either would ship the org's entire dependency&#10;tree to the public registry on every install, which this proxy's&#10;whole posture argues against. npm treats the 404 as 'no summary&#10;available' and continues. The proxy's own CVE gate blocks rather&#10;than reports, which is the stronger coverage for the same purpose." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=10;fontColor=#1f4e79;spacingLeft=10;spacingTop=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="455" y="890" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dec3" value="A DEPLOYMENT WITHOUT [ai_review] REFUSES TO START&#10;The check is config.ai_review(), so a present-but-disabled table is&#10;refused exactly like an absent one: a disabled reviewer cannot review.&#10;Startup logs error! naming that no version could ever be forwarded,&#10;then bails. Serving a registry that can never answer is worse than a&#10;clear startup failure.&#10;/-/ping answers unconditionally and reads no state." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;fontColor=#7f6000;spacingLeft=10;spacingTop=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="850" y="890" width="380" height="110" as="geometry" />
        </mxCell>

        <mxCell id="lockfile" value="THE LOCKFILE DEFECT THE PROXY CANNOT FIX&#10;A lockfile generated before the org adopted the proxy pins each `resolved` URL at the public registry, so `npm ci` fetches those tarballs directly and no gate applies. The proxy cannot intercept a request that is never sent to it. The fix is regenerating lockfiles behind the proxy. The converse is also true: a lockfile made behind the proxy carries internal URLs and does not work outside the network. tests/npm_lockfile.rs pins both directions." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;fontSize=10;fontColor=#9c2b25;fontStyle=1;spacingLeft=10;spacingTop=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1100" width="1200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e_n1_n2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_n2_n3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_n3_n4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_n3_casc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="casc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_casc_n5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="casc" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cg1_2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="1" source="cg1" target="cg2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cg2_3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="1" source="cg2" target="cg3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cg3_4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=1;endArrow=block;endFill=1;" edge="1" parent="1" source="cg3" target="cg4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cg4_5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="cg4" target="cg5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cg5_6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="cg5" target="cg6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_n5_d1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="n5" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_n5_d1_l" value="when npm asks for the tarball" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#b85450;" vertex="1" connectable="0" parent="e_n5_d1">
          <mxGeometry x="0.1" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_d1_d2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="d1" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d2_d3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="d2" target="d3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d2_d4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="d2" target="d4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d2_d4_l" value="approved" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#375623;" vertex="1" connectable="0" parent="e_d2_d4">
          <mxGeometry x="0.1" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d4_d5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="d4" target="d5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_d5_d6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="d5" target="d6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_routed_d1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="routed" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Legend" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1260" y="480" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="gate / refusal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="1260" y="510" width="180" height="34" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="clean / serve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="1260" y="555" width="180" height="34" as="geometry" />
        </mxCell>
        <mxCell id="lg3" value="proxy code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="1260" y="600" width="180" height="34" as="geometry" />
        </mxCell>
        <mxCell id="lg4" value="override / annotation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="1260" y="645" width="180" height="34" as="geometry" />
        </mxCell>
        <mxCell id="lg5" value="npm client action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="1260" y="690" width="180" height="34" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
