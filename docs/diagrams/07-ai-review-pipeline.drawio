<mxfile host="app.diagrams.net" agent="supply-chain-scanner" version="24.0.0">
  <diagram id="ai-pipeline" name="7. AI Review Pipeline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="AI Review Pipeline" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Optional third gate. One budget covers collector plus provider plus retry, so a slow collector leaves the provider less time rather than stacking timeouts." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="1250" height="24" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="Unpacked artifact&#10;(package dir)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="1. COLLECTOR&#10;runs in the sandbox&#10;src/ai/collect.rs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="290" y="120" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2_n" value="Walks the tree, classifies every file, and builds the payload:&#10;install commands (package.json scripts, always sent whole),&#10;install surface first, then reviewable files, then coverage&#10;figures, then opaque executables. Emits nonce-tagged blocks." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="290" y="208" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="2. PROMPT BUILD&#10;src/ai/prompt.rs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="3. PROVIDER CALL&#10;OpenAI-compatible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="800" y="120" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="4. PARSE REPLY&#10;verdict + summary + findings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1040" y="120" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="budget" value="ONE DEADLINE = cfg.timeout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="340" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lb1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;strokeWidth=1;endArrow=none;dashed=1;" edge="1" parent="1" source="budget" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lb2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;strokeWidth=1;endArrow=none;dashed=1;" edge="1" parent="1" source="budget" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="decide_title" value="5. DECIDE — the fixed order, first match wins" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="700" height="28" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="1. Model verdict vs block_on&#10;malicious always blocks;&#10;suspicious blocks only if configured" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="2. Install surface complete?&#10;a file too large to send means&#10;the review never saw what runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="460" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="3. Coverage threshold&#10;reviewable bytes sent / total&#10;below cfg.coverage_threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="540" y="460" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="4. Opaque executables&#10;blocked when the operator&#10;enabled that rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="780" y="460" width="210" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ed1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="d1" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="d2" target="d3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="d3" target="d4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="clean" value="All four pass&#10;→ ReviewOutcome::Clean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="460" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ed4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="d4" target="clean">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="blocked" value="Any match&#10;→ ReviewOutcome::Blocked(reason)&#10;stored as a durable verdict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="unver" value="Collector failed, provider failed, reply unreadable or&#10;truncated, or the review row could not be stored&#10;→ ReviewOutcome::Unverifiable(reason)&#10;NOTHING is stored, so a later request retries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="580" width="360" height="70" as="geometry" />
        </mxCell>

        <mxCell id="eu1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="s2" target="unver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eu1_l" value="could not run" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#d79b00;" vertex="1" connectable="0" parent="eu1">
          <mxGeometry x="0.2" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eu2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="s4" target="unver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eu2_l" value="failed or unreadable" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#d79b00;" vertex="1" connectable="0" parent="eu2">
          <mxGeometry x="0.2" relative="1" as="geometry" />
        </mxCell>

        <mxCell id="store" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="1160" height="200" as="geometry" />
        </mxCell>
        <mxCell id="store_t" value="6. STORE — the reviews table (every outcome that reached a decision)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#375623;" vertex="1" parent="1">
          <mxGeometry x="72" y="708" width="700" height="24" as="geometry" />
        </mxCell>
        <mxCell id="store_c" value="Recorded per review: artifact identity, policy fingerprint, verdict, blocked flag, summary, findings, coverage,&#10;reviewable bytes total and sent, opaque executables, reviewed paths, model, prompt version, collector version, timestamp.&#10;&#10;Why this matters: the model's own text never reaches a refusal detail or a reason phrase, because a hostile model could&#10;quote a key or plant a fake code there. The refusal detail states the verdict in our words; the model's summary lives&#10;in this row and in the log instead. /why/&lt;id&gt; and /api/reviews read this table to explain what was reviewed and why.&#10;&#10;The prompt and collector versions are part of the policy fingerprint, so bumping either re-reviews every artifact in&#10;every ecosystem once, on first request after the upgrade." style="text;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;fontColor=#1a1a1a;spacingLeft=2;" vertex="1" parent="1">
          <mxGeometry x="72" y="736" width="1130" height="150" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Legend" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="940" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="blocking decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="970" width="160" height="36" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="clean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="235" y="970" width="130" height="36" as="geometry" />
        </mxCell>
        <mxCell id="lg3" value="unverifiable (nothing stored)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="970" width="200" height="36" as="geometry" />
        </mxCell>
        <mxCell id="lg4" value="pipeline stage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="595" y="970" width="160" height="36" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
